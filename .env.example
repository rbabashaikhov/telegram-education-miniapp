# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000
PORT=3000

# SQLite path. Docker / VPS: /data/education.db with a volume mounted at /data
DATABASE_PATH=

# Telegram Bot token from @BotFather (required for production initData validation)
TELEGRAM_BOT_TOKEN=

# When true (or when TELEGRAM_BOT_TOKEN is empty), browser demo mode is allowed
ALLOW_DEMO_MODE=true

TZ=Europe/Moscow
PUBLIC_DIR=
VITE_API_URL=

BUSINESS_NAME=BrightWay Education
APP_TITLE=BrightWay
APP_DESCRIPTION=Личный кабинет учебного центра: подбор программы, пробное занятие, абонемент и прогресс.
BRAND_ACCENT=#1F5C4D
BRAND_LOGO_URL=

# local = SQLite is the source of truth. external = CRM stub (501 until an adapter exists).
DATA_MODE=local

# local | external — CRM sync boundary (independent of DATA_MODE)
CRM_ADAPTER=local

# local | webhook | mock
EVENT_ADAPTER=local
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_SECRET=
EVENT_WEBHOOK_TIMEOUT_MS=5000

# local | mock
NOTIFICATION_ADAPTER=local

# mock | external
PAYMENT_ADAPTER=mock

FEATURE_DEMO_TOUR=true
FEATURE_DEMO_ADMIN_PREVIEW=true

# Fail-closed for writes. Empty token locks /api/admin writes.
ADMIN_TOKEN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

RETENTION_EXPIRING_DAYS=14
RETENTION_LOW_BALANCE=2
RETENTION_INACTIVE_ABSENCES=3
